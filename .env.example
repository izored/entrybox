# EntryBox configuration
# Copy to .env and adjust values

# Server bind address — keep 127.0.0.1 for local-only (recommended)
ENTRYBOX_BIND=127.0.0.1
ENTRYBOX_PORT=3859

# Directory where entrybox.json is stored
# Defaults to ./data relative to the app
ENTRYBOX_DATA_DIR=./data

# Optional: webhook URL for state-change events
# ENTRYBOX_WEBHOOK_URL=http://localhost:9000/entrybox-hook

# Max attachment size in MB (upload + serving). Default 25.
# ENTRYBOX_MAX_UPLOAD_MB=25

# Optional shared secret. When set, file/tree/attachment routes require a
# matching X-EntryBox-Token header (recommended if you bind off-loopback).
# ENTRYBOX_TOKEN=
